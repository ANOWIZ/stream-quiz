{
  "name": "ston-stream-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:services": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:generate": "prisma generate",
    "db:push": "node scripts/database.mjs",
    "content:export": "node --import tsx scripts/export-library.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "format": "prettier --write .",
    "host:release": "node scripts/release-host.mjs",
    "verify:clean": "node scripts/clean-install.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "@tailwindcss/vite": "^4.1.13",
    "cookie-parser": "^1.4.7",
    "d3-geo": "^3.1.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.13",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.6.2",
    "prisma": "6.19.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
